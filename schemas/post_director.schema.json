{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://narrative-engine.local/schemas/post_director.schema.json",
  "title": "POST Director result",
  "type": "object",
  "required": [
    "audit",
    "state_delta",
    "relationship_delta",
    "knowledge_delta",
    "thread_delta",
    "world_event_delta",
    "memory_candidates",
    "sprite_decisions"
  ],
  "properties": {
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "audit": {
      "type": "object",
      "required": [
        "valid",
        "errors"
      ],
      "properties": {
        "valid": {
          "type": "boolean"
        },
        "errors": {
          "type": "array"
        }
      },
      "additionalProperties": true
    },
    "state_delta": {
      "type": "object"
    },
    "relationship_delta": {
      "type": "array"
    },
    "knowledge_delta": {
      "type": "array"
    },
    "thread_delta": {
      "type": "object"
    },
    "world_event_delta": {
      "type": "object"
    },
    "memory_candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "type",
          "entities",
          "visibleTo",
          "importance",
          "status"
        ],
        "anyOf": [
          {
            "required": [
              "text"
            ]
          },
          {
            "required": [
              "summary"
            ]
          }
        ],
        "properties": {
          "text": {
            "type": "string",
            "minLength": 1
          },
          "type": {
            "enum": [
              "event",
              "fact",
              "belief",
              "relation",
              "thread",
              "summary"
            ]
          },
          "entities": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "visibleTo": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "importance": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "status": {
            "enum": [
              "current",
              "superseded",
              "disputed"
            ]
          },
          "gameTime": {
            "type": [
              "string",
              "null"
            ]
          },
          "sourceMemoryIds": {
            "type": "array",
            "minItems": 2,
            "maxItems": 16,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "provenance": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "holder",
              "kind",
              "confidence",
              "evidence"
            ],
            "properties": {
              "holder": {
                "type": "string",
                "minLength": 1
              },
              "kind": {
                "enum": [
                  "observed",
                  "reported",
                  "inferred"
                ]
              },
              "confidence": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "evidence": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "ref"
                ],
                "properties": {
                  "ref": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            }
          },
          "links": {
            "type": "array",
            "maxItems": 8,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "relation",
                "targetId",
                "evidence"
              ],
              "properties": {
                "relation": {
                  "enum": [
                    "caused_by",
                    "causes",
                    "supports",
                    "contradicts"
                  ]
                },
                "targetId": {
                  "type": "string",
                  "minLength": 1
                },
                "evidence": {
                  "type": "object",
                  "required": [
                    "ref"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "ref": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "sprite_decisions": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "ops": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "anyOf": [
          {
            "type": "object",
            "required": [
              "op",
              "entity"
            ],
            "properties": {
              "op": {
                "const": "create_entity"
              },
              "entity": {
                "type": "object",
                "required": [
                  "id",
                  "type",
                  "name"
                ],
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "type": {
                    "type": "string",
                    "minLength": 1
                  },
                  "name": {
                    "type": "string",
                    "minLength": 1
                  },
                  "aliases": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "campaignId": {
                    "type": "string",
                    "minLength": 1
                  },
                  "sessionId": {
                    "type": "string",
                    "minLength": 1
                  },
                  "params": {
                    "type": "object"
                  }
                },
                "additionalProperties": false
              }
            },
            "additionalProperties": false
          },
          {
            "type": "object",
            "required": [
              "op",
              "entity",
              "to"
            ],
            "properties": {
              "op": {
                "const": "move"
              },
              "entity": {
                "type": "string",
                "minLength": 1
              },
              "to": {
                "anyOf": [
                  {
                    "type": "null"
                  },
                  {
                    "type": "object",
                    "required": [
                      "rel",
                      "target"
                    ],
                    "properties": {
                      "rel": {
                        "enum": [
                          "on",
                          "in",
                          "inside",
                          "holds",
                          "wears"
                        ]
                      },
                      "target": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "additionalProperties": false
                  }
                ]
              }
            },
            "additionalProperties": false
          },
          {
            "type": "object",
            "required": [
              "op",
              "entity",
              "owner"
            ],
            "properties": {
              "op": {
                "const": "set_owner"
              },
              "entity": {
                "type": "string",
                "minLength": 1
              },
              "owner": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "additionalProperties": false
          },
          {
            "type": "object",
            "required": [
              "op",
              "entity",
              "key",
              "value"
            ],
            "properties": {
              "op": {
                "const": "set"
              },
              "entity": {
                "type": "string",
                "minLength": 1
              },
              "key": {
                "type": "string",
                "minLength": 1
              },
              "value": {}
            },
            "additionalProperties": false
          },
          {
            "type": "object",
            "required": [
              "op",
              "entity",
              "key",
              "amount"
            ],
            "properties": {
              "op": {
                "const": "adjust"
              },
              "entity": {
                "type": "string",
                "minLength": 1
              },
              "key": {
                "type": "string",
                "minLength": 1
              },
              "amount": {
                "type": "number"
              }
            },
            "additionalProperties": false
          },
          {
            "type": "object",
            "required": [
              "op",
              "entity"
            ],
            "properties": {
              "op": {
                "const": "archive_entity"
              },
              "entity": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": false
          },
          {
            "type": "object",
            "required": [
              "op",
              "entity",
              "rel",
              "target"
            ],
            "properties": {
              "op": {
                "const": "link"
              },
              "entity": {
                "type": "string",
                "minLength": 1
              },
              "rel": {
                "type": "string",
                "minLength": 1
              },
              "target": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": false
          },
          {
            "type": "object",
            "required": [
              "op",
              "entity",
              "rel",
              "target"
            ],
            "properties": {
              "op": {
                "const": "unlink"
              },
              "entity": {
                "type": "string",
                "minLength": 1
              },
              "rel": {
                "type": "string",
                "minLength": 1
              },
              "target": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": false
          }
        ]
      }
    },
    "simulation_delta": {
      "type": "object",
      "properties": {
        "events": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "kind": {
                "type": "string",
                "minLength": 1
              },
              "summary": {
                "type": "string",
                "minLength": 1
              },
              "participants": {
                "type": "array",
                "maxItems": 100,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "visibleTo": {
                "type": "array",
                "maxItems": 100,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "significance": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "status": {
                "enum": [
                  "occurred",
                  "scheduled"
                ]
              },
              "dueGameTime": {
                "type": "string",
                "minLength": 1
              },
              "condition": {
                "type": "object",
                "properties": {
                  "eventId": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "eventId"
                ],
                "additionalProperties": false
              },
              "effects": {
                "type": "object",
                "properties": {
                  "weather": {
                    "type": "string",
                    "minLength": 1
                  },
                  "lighting": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [],
                "additionalProperties": false
              },
              "evidence": {
                "anyOf": [
                  {
                    "type": "object",
                    "required": [
                      "ref"
                    ],
                    "properties": {
                      "ref": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 100
                      }
                    },
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "source": {
                        "enum": [
                          "rp",
                          "user_action",
                          "player_assertion"
                        ]
                      },
                      "quote": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "required": [
                      "source",
                      "quote"
                    ],
                    "additionalProperties": false
                  }
                ]
              }
            },
            "required": [
              "id",
              "kind",
              "summary",
              "participants",
              "visibleTo",
              "significance",
              "status"
            ],
            "additionalProperties": false
          }
        },
        "characters": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "type": "object",
            "properties": {
              "characterId": {
                "type": "string",
                "minLength": 1
              },
              "profile": {
                "type": "object",
                "properties": {
                  "age": {
                    "type": "number",
                    "minimum": 0
                  },
                  "traits": {
                    "type": "object"
                  },
                  "formativeExperiences": {
                    "type": "array",
                    "maxItems": 100,
                    "items": {
                      "type": "object"
                    }
                  },
                  "behaviorTendencies": {
                    "type": "object",
                    "properties": {
                      "likelyTo": {
                        "type": "array",
                        "maxItems": 100,
                        "items": {
                          "type": "string",
                          "minLength": 1
                        }
                      },
                      "unlikelyTo": {
                        "type": "array",
                        "maxItems": 100,
                        "items": {
                          "type": "string",
                          "minLength": 1
                        }
                      }
                    },
                    "required": [],
                    "additionalProperties": false
                  }
                },
                "required": [],
                "additionalProperties": false
              },
              "motivation": {
                "type": "array",
                "maxItems": 100,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "mood": {
                "type": "object",
                "properties": {
                  "valence": {
                    "type": "number",
                    "minimum": -1,
                    "maximum": 1
                  },
                  "arousal": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  }
                },
                "required": [
                  "valence",
                  "arousal"
                ],
                "additionalProperties": false
              },
              "body": {
                "type": "object",
                "properties": {
                  "tension": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  "fatigue": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  "pain": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  }
                },
                "required": [],
                "additionalProperties": false
              },
              "appraisals": {
                "type": "array",
                "maxItems": 100,
                "items": {
                  "type": "object",
                  "properties": {
                    "eventId": {
                      "type": "string",
                      "minLength": 1
                    },
                    "meaning": {
                      "type": "string",
                      "minLength": 1
                    },
                    "significance": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    },
                    "confidence": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    },
                    "ambivalence": {
                      "type": "array",
                      "maxItems": 100,
                      "items": {
                        "type": "string",
                        "minLength": 1
                      }
                    }
                  },
                  "required": [
                    "eventId",
                    "meaning",
                    "significance",
                    "confidence"
                  ],
                  "additionalProperties": false
                }
              },
              "emotions": {
                "type": "array",
                "maxItems": 100,
                "items": {
                  "type": "object",
                  "properties": {
                    "type": {
                      "type": "string",
                      "minLength": 1
                    },
                    "intensity": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    },
                    "causeEventId": {
                      "type": "string",
                      "minLength": 1
                    },
                    "toward": {
                      "type": "string",
                      "minLength": 1
                    },
                    "decay": {
                      "enum": [
                        "per_scene",
                        "exponential",
                        "none"
                      ]
                    },
                    "halfLifeMinutes": {
                      "type": "number",
                      "minimum": 1,
                      "maximum": 525600
                    }
                  },
                  "required": [
                    "type",
                    "intensity",
                    "causeEventId",
                    "decay"
                  ],
                  "additionalProperties": false
                }
              },
              "expectations": {
                "type": "array",
                "maxItems": 100,
                "items": {
                  "type": "object",
                  "properties": {
                    "about": {
                      "type": "string",
                      "minLength": 1
                    },
                    "text": {
                      "type": "string",
                      "minLength": 1
                    },
                    "strength": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    }
                  },
                  "required": [
                    "about",
                    "text",
                    "strength"
                  ],
                  "additionalProperties": false
                }
              },
              "expressedVsFelt": {
                "type": "object",
                "properties": {
                  "expressed": {
                    "type": "array",
                    "maxItems": 100,
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "felt": {
                    "type": "array",
                    "maxItems": 100,
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "maskingLevel": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  }
                },
                "required": [
                  "expressed",
                  "felt",
                  "maskingLevel"
                ],
                "additionalProperties": false
              },
              "processing": {
                "type": "array",
                "maxItems": 100,
                "items": {
                  "type": "object",
                  "properties": {
                    "eventId": {
                      "type": "string",
                      "minLength": 1
                    },
                    "interpretation": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "required": [
                    "eventId",
                    "interpretation"
                  ],
                  "additionalProperties": false
                }
              },
              "basis": {
                "enum": [
                  "character_appraisal",
                  "explicit_expression",
                  "player_assertion"
                ]
              },
              "consistency": {
                "type": "object",
                "properties": {
                  "valid": {
                    "type": "boolean"
                  },
                  "reason": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "valid",
                  "reason"
                ],
                "additionalProperties": false
              },
              "development": {
                "type": "array",
                "maxItems": 4,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "id",
                    "description",
                    "context",
                    "eventId",
                    "direction",
                    "interpretation",
                    "confidence"
                  ],
                  "properties": {
                    "id": {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9_-]{1,64}$"
                    },
                    "description": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 500
                    },
                    "context": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 500
                    },
                    "eventId": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 500
                    },
                    "interpretation": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 500
                    },
                    "direction": {
                      "enum": [
                        "supports",
                        "contradicts"
                      ]
                    },
                    "confidence": {
                      "type": "number",
                      "minimum": 0.7,
                      "maximum": 1
                    }
                  }
                }
              }
            },
            "required": [
              "characterId"
            ],
            "additionalProperties": false
          }
        },
        "relationships": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "type": "object",
            "properties": {
              "from": {
                "type": "string",
                "minLength": 1
              },
              "to": {
                "type": "string",
                "minLength": 1
              },
              "dimension": {
                "type": "string",
                "minLength": 1
              },
              "delta": {
                "type": "number",
                "minimum": -1,
                "maximum": 1
              },
              "eventIds": {
                "type": "array",
                "maxItems": 100,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "interpretation": {
                "type": "string",
                "minLength": 1
              },
              "confidence": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            },
            "required": [
              "from",
              "to",
              "dimension",
              "delta",
              "eventIds",
              "interpretation",
              "confidence"
            ],
            "additionalProperties": false
          }
        },
        "schedules": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "characterId": {
                "type": "string",
                "minLength": 1
              },
              "at": {
                "type": "string",
                "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
              },
              "activity": {
                "type": "string",
                "minLength": 1
              },
              "location": {
                "type": "string",
                "minLength": 1
              },
              "visibleTo": {
                "type": "array",
                "maxItems": 100,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "required": [
              "id",
              "characterId",
              "at",
              "activity",
              "visibleTo"
            ],
            "additionalProperties": false
          }
        },
        "resolveEvents": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [],
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
